# ==============================================================================
# REFERA Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your credentials.
# Do NOT commit your actual .env file to version control.
# ==============================================================================

# --- Groq API Key (Required for LLM generation and summarization) ---
# Get yours at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# --- Supabase Configuration (Required for Vector DB, Auth, and Chat Sessions) ---
# Get your Project URL and Anon/Publishable Key from Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_publishable_key_here

# --- Google API Key (Optional / Future Expansion) ---
GOOGLE_API_KEY=your_google_api_key_here

# --- Redis Caching Configuration (Optional - Defaults to local/Docker Redis) ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
